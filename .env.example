TELEGRAM_BOT_TOKEN=
# Use weather_app here. URL-encode special characters in URI passwords.
DATABASE_URL=
HTTP_TIMEOUT=5s
OPENWEATHER_API_KEY=
# WeatherAPI.com Free plan; register and copy the key from your account.
WEATHERAPI_API_KEY=
# MET Norway needs no key. Set a real contact, e.g. weather-sum/1.0 you@your-domain.
MET_NO_USER_AGENT=

# Local PostgreSQL bootstrap account; never use it for the bot.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=application
POSTGRES_PORT=5432

# Use weather_migrator here; goose loads this variable from .env.
GOOSE_DBSTRING=

DB_TIMEOUT=5s
POLL_TIMEOUT=30s
SEND_TIMEOUT=10s
COMMAND_TIMEOUT=25s
SHUTDOWN_TIMEOUT=15s
CACHE_TTL=5m
CACHE_CAPACITY=128
CHAT_COOLDOWN=2s
QUEUE_CAPACITY=1000
WORKERS=4
MAX_ATTEMPTS=3
REQUESTS_PER_SECOND=5
HEALTH_ADDR=127.0.0.1:8080
