[Unit]
Description=Raincheck Telegram weather bot
Wants=network-online.target postgresql.service
After=network-online.target postgresql.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=weather-sum
Group=weather-sum
WorkingDirectory=/opt/weather-sum/current
EnvironmentFile=/etc/weather-sum/app.env
ExecStart=/opt/weather-sum/current/weather-sum
Restart=always
RestartSec=10s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
